port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  node_ip: @@PUBLIC_IP@@
  use_external_ip: false
keys:
  @@LIVEKIT_API_KEY@@: @@LIVEKIT_API_SECRET@@
room:
  auto_create: false
  max_participants: 4
turn:
  enabled: true
  domain: @@TURN_DOMAIN@@
  tls_port: 443
  udp_port: 3478
  cert_file: /etc/letsencrypt/live/pairdesk/fullchain.pem
  key_file: /etc/letsencrypt/live/pairdesk/privkey.pem
logging:
  level: info
