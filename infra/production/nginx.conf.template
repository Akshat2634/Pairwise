worker_processes auto;
events { worker_connections 2048; }
stream {
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $ssl_preread_server_name $tls_upstream {
        @@TURN_DOMAIN@@ livekit:443;
        default 127.0.0.1:8443;
    }
    server {
        listen 443;
        ssl_preread on;
        proxy_pass $tls_upstream;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }
}
http {
    include /etc/nginx/mime.types;
    server_tokens off;
    access_log off;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen 80;
        server_name @@API_DOMAIN@@ @@MEDIA_DOMAIN@@ @@TURN_DOMAIN@@;
        location /.well-known/acme-challenge/ { root /var/www/certbot; }
        location / { return 301 https://$host$request_uri; }
    }
    server {
        listen 127.0.0.1:8443 ssl default_server;
        server_name _;
        ssl_certificate /etc/letsencrypt/live/pairdesk/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pairdesk/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 444;
    }
    server {
        listen 127.0.0.1:8443 ssl;
        server_name @@API_DOMAIN@@;
        ssl_certificate /etc/letsencrypt/live/pairdesk/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pairdesk/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 64k;
        location / {
            proxy_pass http://api:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 30s;
        }
    }
    server {
        listen 127.0.0.1:8443 ssl;
        server_name @@MEDIA_DOMAIN@@;
        ssl_certificate /etc/letsencrypt/live/pairdesk/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pairdesk/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location / {
            proxy_pass http://livekit:7880;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
